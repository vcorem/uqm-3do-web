{
  "name": "uqm-3do-web",
  "version": "0.1.0",
  "private": true,
  "description": "Local WebAssembly game and private two-player Melee relay",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/netplay.mjs",
