{
  "name": "cosmoclash-rust-web",
  "version": "1.0.0",
  "description": "Cosmo Clash: Rust WebAssembly gameplay and private online fleet battles",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npm run build:rust && vite --host 127.0.0.1",
    "build": "npm run build:rust && tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:rust": "bash scripts/build-rust.sh",
    "start": "bash scripts/serve.sh",
    "test:browser": "node tests/browser/solo.mjs && node tests/browser/game.mjs",
    "pretest": "bash scripts/build-native.sh && bash ../scripts/build-rust-relay.sh",
    "test:wasm": "node tests/wasm.mjs",
    "test:provenance": "node tests/provenance.mjs",
    "test:rust": "bash scripts/test-rust.sh",
    "pretest:browser": "bash ../scripts/build-rust-relay.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcorem/uqm-3do-web.git",
    "directory": "cosmoclash"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vcorem/uqm-3do-web/issues"
  },
  "homepage": "https://github.com/vcorem/uqm-3do-web/tree/codex/cosmoclash-rust-netplay/cosmoclash#readme",
  "dependencies": {
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "^0.183.1",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "private": true
}
