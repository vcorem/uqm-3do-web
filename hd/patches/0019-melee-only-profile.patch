+/* The web page opts in before callMain. Latch the profile once so it cannot
+ * accidentally fall back to the campaign menu during a running session. */
+BOOLEAN
+UQM_MeleeOnlyProfile (void)
+{
+#if defined(__EMSCRIPTEN__) && defined(NETPLAY)
+	static int profile = -1;
+	if (profile < 0)
+		profile = MAIN_THREAD_EM_ASM_INT({ return Module.meleeOnly === true ? 1 : 0; });
+	return profile != 0;
+#else
+	return FALSE;
+#endif
+}
