+static BOOLEAN
+pollWebLocalMelee (void)
+{
+	return MAIN_THREAD_EM_ASM_INT({
+		var take = Module.takePendingLocalMelee;
+		try { return typeof take === 'function' && take() ? 1 : 0; }
+		catch (error) { return 0; }
+	});
+}
+
+/* This profile never enters RestartMenu or returns a campaign to StartGame.
+ * Melee itself still owns battle setup, netplay, teardown and saved fleets. */
+static BOOLEAN
+runMeleeOnly (void)
+{
+	BOOLEAN waiting = FALSE;
+	announceWebNetplayHook ();
+	for (;;)
+	{
+		if (webNetplayRole < 0 && !takeWebNetplayRole (pollWebNetplayPage ())
+				&& !pollWebLocalMelee ())
+		{
+			if (!waiting)
+			{
+				setBrowserGameScreen ("meleeMenu");
+				waiting = TRUE;
+			}
+			SleepThread (ONE_SECOND / 30);
+			continue;
+		}
+		waiting = FALSE;
+		LastActivity = NextActivity = 0;
+		GLOBAL (CurrentActivity) = 0;
+		ReinitQueue (&race_q[0]);
+		ReinitQueue (&race_q[1]);
+		SetDefaultMenuRepeatDelay ();
+		FlushInput ();
+		if (webNetplayRole < 0)
+			SeedRandomNumbers ();
+		playWebMelee ();
+	}
 }
