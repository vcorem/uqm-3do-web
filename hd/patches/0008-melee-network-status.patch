+// Called by RepairMeleeFrame() after the repair of pRect.
+// The border padding hides the part of the status line in the screen
+// border, and a repair can cover a part of the line. Thus the line is drawn
+// again on its background after each repair.
 static void
+RepairMeleeStatus (const RECT *pRect)
+{
+	RECT r;
+
+	if (pRect->corner.x == 0 && pRect->corner.y == 0
+			&& pRect->extent.width == SCREEN_WIDTH
+			&& pRect->extent.height == SCREEN_HEIGHT)
+	{	// A full redraw removes the status message.
+		meleeStatusText[0] = '\0';
+	}
+
+	GetMeleeStatusRect (&r);
+	if (meleeStatusText[0] != '\0' && (pRect->corner.x != r.corner.x
+			|| pRect->corner.y != r.corner.y
+			|| pRect->extent.width != r.extent.width
+			|| pRect->extent.height != r.extent.height))
+		RepairMeleeArea (&r);
+
+	DrawBorderPadding (0);
+	DrawMeleeStatusText ();
+}
+
+// Use an empty string to clear the status area.
+static void
+DrawMeleeStatusMessage (const char *message)
+{
+	RECT r;
+
+	// Erase the old message before the new message is drawn.
+	utf8StringCopy (meleeStatusText, sizeof (meleeStatusText), message);
+	GetMeleeStatusRect (&r);
+	RepairMeleeFrame (&r);
+}
