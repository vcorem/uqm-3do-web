+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Separate Melee draw images. Original FRAME geometry and image pixels remain
+ * authoritative for collision. No simulation elements or random calls here. */
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+#include "melee_presentation.h"
+#include "libs/memlib.h"
+#include "libs/uio.h"
+#include "uqm/globdata.h"
+
+extern uio_DirHandle *contentDir;
+typedef struct RenderImage {
+    TFB_Image *original, *rendered;
+    BOOLEAN avenger, meleeUI;
+    struct RenderImage *next;
+} RenderImage;
+static RenderImage *images;
+static atomic_flag registryLock = ATOMIC_FLAG_INIT;
+static atomic_int enabled = 1;
+static atomic_int drawActive;
+static atomic_uint imageCount, drawCount, backgroundCount;
+static BOOLEAN backgroundAttempted;
+static TFB_Image *backgroundImage;
+
+static void lockRegistry (void)
+{
+    while (atomic_flag_test_and_set_explicit (&registryLock, memory_order_acquire)) {}
+}
+static void unlockRegistry (void)
+{
+    atomic_flag_clear_explicit (&registryLock, memory_order_release);
+}
+static TFB_Image *lookup (TFB_Image *original, BOOLEAN *avenger, BOOLEAN *meleeUI)
+{
+    RenderImage *entry;
+    TFB_Image *result = NULL;
+    lockRegistry ();
+    for (entry = images; entry; entry = entry->next)
+        if (entry->original == original) {
+            result = entry->rendered;
+            if (avenger) *avenger = entry->avenger;
+            if (meleeUI) *meleeUI = entry->meleeUI;
+            break;
+        }
+    unlockRegistry ();
+    return result;
+}
+void UQM_SetMeleeRemastered (int value)
+{
+    atomic_store_explicit (&enabled, value != 0, memory_order_release);
+}
+int UQM_GetMeleeRemastered (void)
+{
+    return atomic_load_explicit (&enabled, memory_order_acquire);
+}
+unsigned UQM_GetMeleeRemasteredImageCount (void) { return atomic_load (&imageCount); }
+unsigned UQM_GetMeleeRemasteredDrawCount (void) { return atomic_load (&drawCount); }
+unsigned UQM_GetMeleeRemasteredBackgroundCount (void) { return atomic_load (&backgroundCount); }
+void UQM_MeleePresentationBegin (BOOLEAN isMelee)
+{
+    atomic_store (&drawActive, isMelee && UQM_GetMeleeRemastered ());
+}
+void UQM_MeleePresentationEnd (void) { atomic_store (&drawActive, 0); }
+
+static TFB_Image *loadOptional (const char *path)
+{
+    TFB_Canvas canvas;
+    uio_Stream *file = uio_fopen (contentDir, path, "rb");
+    if (!file) return NULL;
+    uio_fclose (file);
+    canvas = TFB_DrawCanvas_LoadFromFile (contentDir, path);
+    return canvas ? TFB_DrawImage_New (canvas) : NULL;
+}
+void UQM_MeleePresentationRegister (TFB_Image *original, const char *source, const char *resource,
+        COORD hotx, COORD hoty)
+{
+    const char *relative;
+    char path[4096];
+    TFB_Image *rendered;
+    RenderImage *entry;
+    size_t length;
+    BOOLEAN avenger, meleeUI;
+    if (!original || !source) return;
+    relative = strstr (source, "/ships/");
+    if (!relative) relative = strstr (source, "/battle/");
+    if (!relative) return;
+    ++relative;
+    length = strlen (relative);
+    if (length < 4 || strcmp (relative + length - 4, ".png") || strstr (relative, "..")) return;
+    if (snprintf (path, sizeof path, "remastered/render/%s", relative) >= (int) sizeof path) return;
+    avenger = !strncmp (relative, "ships/ilwrath/avenger-", 22);
+    /* Icon ANIs also contain ordinary small-facing PNGs for fleet previews. */
+    meleeUI = resource && (strstr (resource, "-icons.ani") || strstr (resource, "-meleeicons.ani"));
+    rendered = loadOptional (path);
+    if (rendered && (rendered->extent.width != original->extent.width ||
+            rendered->extent.height != original->extent.height)) {
+        TFB_DrawImage_Delete (rendered);
+        rendered = NULL;
+    }
+    if (rendered) {
+        rendered->NormalHs.x = hotx;
+        rendered->NormalHs.y = hoty;
+    }
+    /* Keep cloak identity even when optional art is missing or malformed. */
+    if (!rendered && !avenger) return;
+    entry = HMalloc (sizeof *entry);
+    entry->original = original;
+    entry->rendered = rendered;
+    entry->avenger = avenger;
+    entry->meleeUI = meleeUI;
+    lockRegistry ();
+    entry->next = images;
+    images = entry;
+    if (rendered) atomic_fetch_add (&imageCount, 1);
+    unlockRegistry ();
+}
+TFB_Image *UQM_MeleePresentationImage (TFB_Image *original)
+{
+    TFB_Image *rendered;
+    BOOLEAN meleeUI = FALSE;
+    rendered = lookup (original, NULL, &meleeUI);
+    if (!rendered) return original;
+    if (!atomic_load (&drawActive) && !(meleeUI && UQM_GetMeleeRemastered () &&
+            LOBYTE (GLOBAL (CurrentActivity)) == SUPER_MELEE)) return original;
+    atomic_fetch_add (&drawCount, 1);
+    return rendered;
+}
+BOOLEAN UQM_MeleePresentationHiddenCloak (TFB_Image *original, Color color)
+{
+    BOOLEAN avenger = FALSE;
+    if (!atomic_load (&drawActive) || color.r || color.g || color.b) return FALSE;
+    lookup (original, &avenger, NULL);
+    return avenger;
+}
+void UQM_MeleePresentationMipmap (TFB_Image *original, TFB_Image *mipmap,
+        int hotx, int hoty)
+{
+    TFB_Image *rendered = lookup (original, NULL, NULL);
+    TFB_Image *renderedMipmap = lookup (mipmap, NULL, NULL);
+    if (rendered && renderedMipmap)
+        TFB_DrawScreen_SetMipmap (rendered, renderedMipmap, hotx, hoty);
+}
+void UQM_MeleePresentationForget (TFB_Image *original)
+{
+    RenderImage **cursor, *entry = NULL;
+    lockRegistry ();
+    for (cursor = &images; *cursor; cursor = &(*cursor)->next)
+        if ((*cursor)->original == original) {
+            entry = *cursor;
+            *cursor = entry->next;
+            if (entry->rendered) atomic_fetch_sub (&imageCount, 1);
+            break;
+        }
+    unlockRegistry ();
+    if (entry) {
+        /* Runs with the original image's deferred deletion, after queued draws. */
+        if (entry->rendered) TFB_DrawImage_Delete (entry->rendered);
+        HFree (entry);
+    }
+}
+void UQM_MeleePresentationBackground (void)
+{
+    DrawMode mode;
+    if (!atomic_load (&drawActive)) return;
+    if (!backgroundAttempted) {
+        backgroundAttempted = TRUE;
+        backgroundImage = loadOptional ("remastered/render/background.png");
+    }
+    if (!backgroundImage) return;
+    atomic_fetch_add (&backgroundCount, 1);
+    mode.kind = 0;
+    mode.factor = 0;
+    /* Draw-command clipping is inherited from SpaceContext, preserving the HUD. */
+    TFB_DrawScreen_Image (backgroundImage, 0, 0, 256, 0, NULL, mode, TFB_SCREEN_MAIN);
+}
