+unsigned UQM_GetMeleeRemasteredCaptainImageCount (int race)
+{
+    RenderImage *entry;
+    unsigned count = 0;
+    if (race < 0 || race >= 25) return 0;
+    lockRegistry ();
+    for (entry = images; entry; entry = entry->next)
+        if (entry->captainRace == race && entry->captainReady) ++count;
+    unlockRegistry ();
+    return count;
+}
+unsigned UQM_GetMeleeRemasteredCaptainDrawCount (int race, int row)
+{
+    unsigned count = 0;
+    int i;
+    if (race < 0 || race >= 25 || row < -1 || row >= 20) return 0;
+    if (row >= 0) return atomic_load (&captainDraws[race][row]);
+    for (i = 0; i < 20; ++i) count += atomic_load (&captainDraws[race][i]);
+    return count;
+}
+unsigned UQM_GetMeleeRemasteredCaptainSeenMask (int race)
+{
+    return race >= 0 && race < 25 ? atomic_load (&captainSeen[race]) : 0;
+}
+unsigned UQM_MeleePresentationCaptainBegin (void)
+{
+    unsigned previous = atomic_load (&captainMode);
+    if (!previous)
+        atomic_store (&captainMode, UQM_GetMeleeRemastered () &&
+            LOBYTE (GLOBAL (CurrentActivity)) == SUPER_MELEE ? 2 : 1);
+    return previous;
+}
+void UQM_MeleePresentationCaptainEnd (unsigned previous)
+{
+    atomic_store (&captainMode, previous);
+}
+/* Keep a final partial death patch in the style of its existing portrait.
+ * The requested setting is unchanged; only this draw scope inherits the pose. */
+unsigned UQM_MeleePresentationCaptainBeginFinalFrame (int player, const void *portrait)
+{
+    unsigned previous = UQM_MeleePresentationCaptainBegin ();
+    if (!previous && player >= 0 && player < 2 && portrait &&
+            LOBYTE (GLOBAL (CurrentActivity)) == SUPER_MELEE &&
+            atomic_load (&captainLastImage[player]) == (uintptr_t) portrait) {
+        unsigned mode = atomic_load (&captainLastMode[player]);
+        if (mode) atomic_store (&captainMode, mode);
+    }
+    return previous;
+}
+BOOLEAN UQM_MeleePresentationCaptainNeedsRefresh (int player, const void *portrait)
+{
+    uintptr_t previousImage;
+    unsigned mode, previousMode;
+    if (player < 0 || player >= 2 || !portrait ||
+            LOBYTE (GLOBAL (CurrentActivity)) != SUPER_MELEE) return FALSE;
+    mode = atomic_load (&captainMode);
+    if (!mode) return FALSE;
+    previousImage = atomic_exchange (&captainLastImage[player], (uintptr_t) portrait);
+    previousMode = atomic_exchange (&captainLastMode[player], mode);
+    return previousImage != (uintptr_t) portrait || previousMode != mode;
+}
+unsigned UQM_MeleePresentationNextDrawable (void)
+{
+    return atomic_fetch_add (&nextDrawable, 1);
+}
+void UQM_MeleePresentationFinalizeCaptain (unsigned drawable, unsigned frameCount)
+{
+    RenderImage *entry;
+    unsigned count = 0, seen = 0;
+    BOOLEAN ready = frameCount > 0 && frameCount <= 20;
+    lockRegistry ();
+    for (entry = images; entry; entry = entry->next)
+        if (entry->captainRace >= 0 && entry->drawable == drawable) {
+            ++count;
+            seen |= 1u << entry->captainRow;
+            if (!entry->rendered) ready = FALSE;
+        }
+    ready = ready && count == frameCount && seen == (1u << frameCount) - 1;
+    for (entry = images; entry; entry = entry->next)
+        if (entry->captainRace >= 0 && entry->drawable == drawable)
+            entry->captainReady = ready;
+    unlockRegistry ();
+}
